ARG BASE_IMAGE=docker.io/library/debian@sha256:5ae3c39ebd15e229dcedd5cee596b2497182493d41ff162e824ba13fc1b2b867
FROM ${BASE_IMAGE}
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential pkg-config ca-certificates curl git python3 cmake ninja-build \
    libluajit-5.1-dev libasound2-dev libglfw3-dev libglew-dev libfreeimage-dev \
    libfreetype6-dev libopenal-dev libsndfile1-dev libudev-dev libcurl4-openssl-dev \
    liburiparser-dev libpugixml-dev librtaudio-dev libpulse-dev libgtk-3-dev \
    libgstreamer1.0-dev libgstreamer-plugins-base1.0-dev libmpg123-dev \
    libgles2-mesa-dev libegl1-mesa-dev libdrm-dev libgbm-dev xvfb xauth mesa-utils \
    && dpkg-query -W > /build-packages.lock && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
RUN apt-get update && apt-get install -y --no-install-recommends libssl-dev freeglut3-dev libxxf86vm-dev \
    && dpkg-query -W > /build-packages.lock && rm -rf /var/lib/apt/lists/*
