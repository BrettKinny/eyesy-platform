[Unit]
Description=EYESY Lua graphics platform
After=local-fs.target eyesyhw.service ttymidi.service
Wants=eyesyhw.service ttymidi.service
Conflicts=eyesypy.service
StartLimitIntervalSec=60
StartLimitBurst=3
OnFailure=eyesy-platform-fallback.service

[Service]
Type=notify
NotifyAccess=all
User=music
Group=music
SupplementaryGroups=audio video render input
EnvironmentFile=-/sdcard/eyesy-platform/active.env
WorkingDirectory=/sdcard/eyesy-platform/current
# Direct KMS scanout: no Xorg anywhere in the display path (Xorg sessions on
# this hardware trip a sticky HDMI_VID_CTL bit that blanks output until power
# cycle; see docs/HDMI-DISPLAY-ISSUE.md). The engine takes DRM master and
# selects a kernel-EDID mode itself.
ExecStart=/sdcard/eyesy-platform/current/eyesy-engine --kms --mode /sdcard/eyesy-platform/current/modes/starter --storage /sdcard/eyesy-platform --audio-device auto --osc-port 4000
Restart=on-failure
RestartSec=2
WatchdogSec=10
TimeoutStartSec=30
TimeoutStopSec=5
KillMode=control-group

[Install]
WantedBy=multi-user.target